# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# True while developing on your computer, False when the site is online
DJANGO_DEBUG=True

# Comma-separated. Add your real domain when you deploy, e.g. yourname.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed only when DEBUG=False and you use HTTPS, e.g. https://yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# "slideshow" cycles through all pictures in static/backgrounds/
# "random" picks one picture per page load
BACKGROUND_MODE=slideshow

# Optional: get an email when someone uses the contact form
CONTACT_NOTIFY_EMAIL=
